# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite o .env.local (já está no .gitignore).

# --- Supabase (Dashboard → Settings → API Keys) ---
# As duas primeiras precisam do prefixo VITE_ porque são lidas no
# navegador (Vite só expõe variáveis com esse prefixo pro cliente).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Mesmos valores, sem o prefixo VITE_ - usados pela função serverless em
# api/chatWithAI.js (roda no servidor, não no navegador).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Login nativo no Android ---
# Google Cloud Console → seu projeto → Credentials → OAuth 2.0 Client ID
# do tipo "Web application" (o mesmo tipo usado antes com o Firebase - o
# plugin de login social usa o Web Client ID em todas as plataformas,
# inclusive Android, não o Client ID Android).
VITE_GOOGLE_WEB_CLIENT_ID=

# --- IA (gratuitas, sem cartão) ---
# console.groq.com → API Keys
GROQ_API_KEY=

# aistudio.google.com/apikey (Google AI Studio)
GEMINI_API_KEY=

# Opcionais - só preencha se quiser trocar o modelo padrão (ex: se algum
# dos defaults abaixo for descontinuado ou sair do tier gratuito).
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
